# ===== EduMeet 后端配置 =====
# EduMeet 业务库：仅供本项目 SQLAlchemy 读写，与 Langfuse 存储无关
# MySQL 8 本地开发连接；请将用户名和密码替换为本机实际配置
DATABASE_URL=mysql+aiomysql://root:your_password@127.0.0.1:3306/edumeet?charset=utf8mb4
# 无 MySQL 环境时可临时使用 SQLite：sqlite+aiosqlite:///./edumeet.db

# JWT
JWT_SECRET=dev-secret-change-me
JWT_EXPIRE_MINUTES=720

# ===== 大模型接入 =====
# DeepSeek 真实接入（llm_models.provider=deepseek 时路由到此处；其余模型可保留 mock）
# 填入官网 https://platform.deepseek.com 申请的完整 Key，重启后端生效
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# LiteLLM 网关（M1 迭代启用）
LLM_PROVIDER=mock
# LITELLM_BASE_URL=http://localhost:4000
# LITELLM_API_KEY=sk-xxx
# Langfuse 可观测性：继续使用现有 Langfuse 服务及其原有存储，不写入 edumeet DB
LANGFUSE_PUBLIC_KEY="pk-lf-..."
LANGFUSE_SECRET_KEY="sk-lf-..."
LANGFUSE_HOST="http://localhost:3000"
