# ===== EduMeet 后端配置 =====
# 存储层：按 Spec 约定生产使用 PostgreSQL/Redis；本地开发降级 SQLite，无需额外安装
DATABASE_URL=sqlite+aiosqlite:///./edumeet.db
# DATABASE_URL=postgresql+asyncpg://edumeet:edumeet@localhost:5432/edumeet

# JWT
JWT_SECRET=dev-secret-change-me
JWT_EXPIRE_MINUTES=720

# ===== 大模型接入 =====
# DeepSeek 真实接入（模型 deepseek-chat 自动路由到此处；其余模型仍为 mock）
# 填入官网 https://platform.deepseek.com 申请的完整 Key，重启后端生效
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# LiteLLM 网关（M1 迭代启用）
LLM_PROVIDER=mock
# LITELLM_BASE_URL=http://localhost:4000
# LITELLM_API_KEY=sk-xxx
# Langfuse 可观测性（自建服务或 SaaS，均可）
LANGFUSE_PUBLIC_KEY="pk-lf-..."
LANGFUSE_SECRET_KEY="sk-lf-..."
LANGFUSE_HOST="http://localhost:3000"
